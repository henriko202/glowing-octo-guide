VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE=https://your-deployment.convex.site
# Marketing/landing site (separate Next.js app). Sign-out redirects here. Dev: http://localhost:3000
VITE_LANDING_URL=https://linkintothessi.com
VITE_STRIPE_STARTER_PRICE_ID=price_xxx
VITE_STRIPE_GROWTH_PRICE_ID=price_xxx
VITE_STRIPE_PRO_PRICE_ID=price_xxx
# Annual price IDs. Same values as Convex STRIPE_*_ANNUAL_PRICE_ID, but the app uses the
# VITE_ names (build-time). Set these in the app's Cloudflare build env, NOT in Convex.
VITE_STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
VITE_STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxx
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
# Cross-site cookie domain (theme + language shared between app + landing).
# Prod: .linkintothessi.com  |  Dev: leave UNSET (host-only cookie).
VITE_COOKIE_DOMAIN=
