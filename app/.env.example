VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE=https://your-deployment.convex.site
# Marketing/landing site (separate Next.js app). Sign-out redirects here. Dev: http://localhost:3000
VITE_LANDING_URL=https://www.linkintothessi.com
VITE_STRIPE_STARTER_PRICE_ID=price_xxx
VITE_STRIPE_GROWTH_PRICE_ID=price_xxx
VITE_STRIPE_PRO_PRICE_ID=price_xxx
# Annual price IDs. Same values as Convex STRIPE_*_ANNUAL_PRICE_ID, but the app uses the
# VITE_ names (build-time). Set these in the app's Cloudflare build env, NOT in Convex.
VITE_STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
VITE_STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxx
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
# Cross-site cookie domain (theme + language shared between app + landing).
# Prod: .linkintothessi.com  |  Dev: leave UNSET (host-only cookie).
VITE_COOKIE_DOMAIN=
# Observability (prod only). All three are build-time — set them in the app's Cloudflare build env,
# and leave them UNSET in dev so Sentry/PostHog stay no-ops locally.
# Sentry frontend error monitoring (necessary/security purpose; runs regardless of consent, PII scrubbed).
VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# PostHog product analytics (analytics purpose; captures ONLY after a user grants `analytics` consent).
VITE_POSTHOG_KEY=phc_<your_project_key>
# PostHog ingestion host. EU cloud by default. Prod uses the managed reverse proxy below; a different
# host must also be added to the CSP in scripts/gen-headers.mjs or the browser blocks it.
VITE_POSTHOG_HOST=https://t.linkintothessi.com
# DataFast web analytics (analytics purpose; starts ONLY for a signed-in member who granted `analytics` consent).
# Public website id, shared with the landing. Inert in dev builds even when set.
VITE_DATAFAST_WEBSITE_ID=dfid_8IrKZ1PONPjcOv8mSg4o2
