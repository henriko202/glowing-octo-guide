LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback
APP_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx
# Annual price IDs (2 months free: Starter $50/yr, Growth $150/yr, Pro $500/yr).
# Create these in Stripe Dashboard → Products → each plan → Add price (Annual / $X).
STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
APIFY_API_TOKEN=your_apify_api_token
APIFY_TASK_ID=harvestapi~linkedin-profile-posts
APIFY_TASK_ID_PROFILE_SCRAPE=harvestapi~linkedin-profile-scraper
# OpenRouter (AI reaction prediction + comment drafting). Unset ⇒ AI features no-op (reactions
# default to LIKE; the Generate button reports "AI unavailable"). Provider routing is pinned IN CODE to
# DeepInfra fp8 with zero-data-retention + no-training (see convex/ai/openrouter.ts + docs/compliance).
OPENROUTER_API_KEY=
# Optional model slug override (default: google/gemma-4-26b-a4b-it)
OPENROUTER_MODEL=
# Optional attribution for OpenRouter's public rankings (sent as HTTP-Referer / X-Title). Leave unset
# to stay off the rankings.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
