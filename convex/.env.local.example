# Convex backend environment — set these in the Convex dashboard
# (Settings → Environment Variables), NOT in a local file. Copy is for reference only.
# Canonical inventory + failure modes: docs/PLATFORM.md §16.

# ── LinkedIn OAuth ──────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# MUST point at Convex (.convex.site), NOT the app. LinkedIn returns the code here;
# Convex exchanges it server-side so the client secret + user tokens never hit the browser.
LINKEDIN_REDIRECT_URI=https://your-deployment.convex.site/auth/linkedin/callback

# Browser redirect base (OAuth success/error + Stripe success/cancel/portal).
# Dev: match the port Vite actually serves on — 5174 (app/vite.config.ts).
# Prod: https://www.app.linkintothessi.com (no trailing slash).
APP_URL=http://localhost:5174

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Monthly price IDs → tier. Backend reads these EXACT names (no VITE_ prefix).
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx
# Annual price IDs (2 months free: Starter $100/yr, Growth $150/yr, Pro $500/yr).
# Create these in Stripe Dashboard → Products → each plan → Add price (Annual).
# ⚠ Backend reads STRIPE_*_ANNUAL_PRICE_ID (NO VITE_ prefix). The app build reads the
#   VITE_STRIPE_*_ANNUAL_PRICE_ID copies (app/.env.example) — SAME value, both places.
#   A VITE_-prefixed annual var in Convex is inert: annual checkout → 'Invalid price ID'.
STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
# backlog/R17 — one-time $5 "Featured post" Price (Checkout mode: payment). Not a tier; never in the
# subscription allowlist. Fulfilled by the checkout.session.completed webhook.
STRIPE_FEATURED_POST_PRICE_ID=price_xxx

# ── Apify (post + profile ingestion) ────────────────────────────────────────
# Unset ⇒ sync/scrape no-op. The TASK_ID values below are the real actor slugs.
APIFY_API_TOKEN=your_apify_api_token
APIFY_TASK_ID=harvestapi~linkedin-profile-posts
APIFY_TASK_ID_PROFILE_SCRAPE=harvestapi~linkedin-profile-scraper

# ── Transactional email (Resend) ────────────────────────────────────────────
# Both required for email (DSR confirmations + breach notices); unset ⇒ email no-ops.
RESEND_API_KEY=
# Bare address: sendEmail labels it "Link Into The SSI <address>". A full "Name <address>" here is kept as-is.
EMAIL_FROM=noreply@linkintothessi.com
# Optional Reply-To on feedback reply emails (so users can reply to a human). Unset ⇒ no header.
FEEDBACK_REPLY_TO=feedback@linkintothessi.com

# ── Digest unsubscribe (R24) ────────────────────────────────────────────────
# HMAC-SHA256 key for the stateless 3-day activity-digest unsubscribe tokens.
# UNSET ⇒ the digest sweep logs and sends nothing (no email goes out without a working opt-out).
UNSUBSCRIBE_SECRET=

# ── Digest postal address (R24) ─────────────────────────────────────────────
# CAN-SPAM postal address in the digest footer. Unset (or any value other than 'false') keeps the controller's
# fiscal address; set exactly 'false' to omit it. Production leaves it unset.
INCLUDE_DIGEST_ADDRESS=

# ── AI (OpenRouter → DeepInfra Gemma, zero data retention) ──────────────────
# Unset ⇒ AI no-ops (reactions default to LIKE; Generate button reports "AI unavailable").
# Provider routing (ZDR + no-training pin) is enforced in code, not via env.
OPENROUTER_API_KEY=
# Optional model slug override (default: google/gemma-4-26b-a4b-it)
OPENROUTER_MODEL=
# Optional attribution for OpenRouter's public rankings (HTTP-Referer / X-Title). Unset ⇒ not sent.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ── Dev-only admin override ─────────────────────────────────────────────────
# 'true' lets an admin bypass post-ownership verification + posting throttles in submitPost.
# Set ONLY on a local/dev deployment. MUST be unset in production.
ALLOW_ADMIN_SHARE_ANY_POST=

# ── Dev-only user impersonation ─────────────────────────────────────────────
# 'true' enables dev.listUsers / dev.impersonate (the app's floating "DEV · Impersonate" switcher,
# rendered only in vite dev). Set ONLY on a local/dev deployment. MUST be unset in production.
ALLOW_DEV_IMPERSONATION=
