NEXT_PUBLIC_APP_URL=https://www.app.linkintothessi.com
# Canonical public origin of the landing site. Used for absolute canonical/OpenGraph URLs,
# hreflang alternates, the sitemap, and JSON-LD. Defaults to https://www.linkintothessi.com.
NEXT_PUBLIC_SITE_URL=https://www.linkintothessi.com
# Convex .site base. The landing no longer links here directly: CTAs point at
# ${NEXT_PUBLIC_APP_URL}/auth/start, which generates the PKCE challenge before bouncing to Convex.
NEXT_PUBLIC_CONVEX_SITE=https://your-deployment.convex.site

# Cross-site cookie domain (theme + language shared between landing + app).
# Prod: .linkintothessi.com  |  Dev: leave UNSET (host-only cookie).
NEXT_PUBLIC_COOKIE_DOMAIN=
